# Copiar a .env y ajustar. El .env real NUNCA se commitea.
APP_VERSION=1.0.0
ENTORNO=local
FECHA_INICIO_OPERACIONES=2026-09-01
CHAOS_ENABLED=false

# Grafana Cloud (solo para `docker compose --profile observability up`).
# Los datos salen de grafana.com > tu stack > Prometheus / Loki > Details.
# El token es un Access Policy token con permisos metrics:write y logs:write.
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=000000
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=000000
GRAFANA_CLOUD_API_TOKEN=
